	"git": {
		"deploymentEnabled": {
			"main": true,
			"*": false,
			"*/*": false,
			"*/*/*": false,
			"*/*/*/*": false,
			"**": false
		}
	},
	"headers": [
		{
			"source": "/(.*)",
