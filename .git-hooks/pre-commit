#!/usr/bin/env bash
((BASH_VERSINFO[0] >= 5)) || { echo "✗ $0 requires Bash >= 5, not $BASH_VERSION. Fix: brew install bash; open a fresh shell and rerun repository setup." >&2; exit 1; }
# Repository-owned quality gate; Vercel owns deployment after merge.
set -euo pipefail

gate_lib="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/gate/gate-lib.sh"
# shellcheck source=/dev/null
_repo_owned_gate_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$_repo_owned_gate_root/gate/gate-lib.sh"
# Gate the tree being committed, not this copy's: under an absolute core.hooksPath (Claude
# desktop worktrees) this re-execs the committing tree's own hook; it sets ROOT and cd's.
gate_enter_committing_tree "${BASH_SOURCE[0]}"
gate_begin_commit "jsolly-website"    # staged secrets/md-lint; merge/empty skips; doc-only fast path; banner; ERR trap
run_step "bash floor" gate_check_bash_floor   # every Bash entrypoint refuses Bash < 5
gate_require_node                     # enforce the pinned Node (.nvmrc), not whatever's on PATH
# The caller verifies live draft+preview PR/head context through GitHub before
# using this shortcut. The scope guard independently rejects non-UI deltas.
if [[ "${FLEET_UI_PREVIEW:-0}" == 1 ]]; then
	if [[ ! -f "$gate_lib" ]]; then
		echo "✗ UI preview requires the repository gate's secrets/bootstrap checks." >&2
		exit 1
	fi
	run_step "UI preview scope" node scripts/ui-preview-scope.mjs
	run_step "UI preview checks" npm run check:preview
	echo "✓ preview checks passed — full gate and required ci still needed before ready/merge."
	exit 0
fi
run_step "biome ci"  npx --no-install biome ci . --error-on-warnings
run_step "yaml lint" npm run check:yaml
run_step "knip" npm run check:knip
run_step "legacy redirects" npm run redirects:check   # legacy/blogthedata/vercel.json matches url-map.json
run_step "recipe data" npm run recipes:check   # public/recipes/data matches recipes.json
run_step "actionlint"             npm run check:actions
run_step "markdown lint" npm run check:md
run_step "smoke scenario" npm run smoke:scenario-contract
run_step "types (astro + svelte)" npm run check:ts
run_step "unit tests" npm test
run_step "build"     npm run build
run_step "built tests" npm run test:built

run_step "repository hook trust" bash scripts/repo-python.sh scripts/test-repo-hooks.py

echo "✓ pre-commit gate passed — commit will land; Vercel deploys via GitHub integration after merge to main."
