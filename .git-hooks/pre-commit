#!/usr/bin/env bash
# Pre-commit GATE for jsolly-website (gate-only — this hook does NOT deploy).
#
# Thin shim over the shared fleet gate library (dotagents/gate/gate-lib.sh): the
# shared boilerplate — the staged secrets scan, markdown-lint-on-change, the
# doc-only fast path, the merge/rebase and empty-commit skips, and run_step
# (silent on green, full output on red) — live in the lib. This file declares
# only jsolly-website's quality steps, gated per commit. Production deploy is
# owned by Vercel's GitHub integration after the commit lands on main; CI
# backstops the gate on the PR.
((BASH_VERSINFO[0] >= 5)) || { echo "✗ $0 requires Bash >= 5, not $BASH_VERSION. Fix: brew install bash; rerun bash ~/code/dotagents/setup/install-local-agent-runtime.sh; open a new shell." >&2; exit 1; }
set -euo pipefail

# The degraded branch is only for a genuinely absent lib: GitHub CI, or a Cloud Agent VM before its
# installer ran. A lib that exists but fails to load (unreadable, syntax error, a refusal at source
# time) aborts the commit under set -e instead of falling through. An explicit DOTAGENTS_GATE_LIB
# override that names no file is a misconfiguration, not an absent lib, so it aborts too.
gate_lib="${DOTAGENTS_GATE_LIB:-$HOME/code/dotagents/gate/gate-lib.sh}"
if [[ -n "${DOTAGENTS_GATE_LIB:-}" && ! -f "$gate_lib" ]]; then
	echo "✗ DOTAGENTS_GATE_LIB=$gate_lib is not a file." >&2
	exit 1
fi
if [[ -f "$gate_lib" ]]; then
	# shellcheck source=/dev/null
	source "$gate_lib"
	# Gate the tree being committed, not this copy's: under an absolute core.hooksPath (Claude
	# desktop worktrees) this re-execs the committing tree's own hook; it sets ROOT and cd's.
	gate_enter_committing_tree "${BASH_SOURCE[0]}"
	gate_require_lib 12  # gate_check_bash_floor
	gate_begin_commit "jsolly-website"    # staged secrets/md-lint; merge/empty skips; doc-only fast path; banner; ERR trap
	run_step "bash floor" gate_check_bash_floor   # every Bash entrypoint refuses Bash < 5
	gate_require_node                     # enforce the pinned Node (.nvmrc), not whatever's on PATH
else
	# Run the same quality battery without fleet boilerplate (secrets scan, doc-only fast path,
	# node pin).
	echo "⚠ gate-lib not found at $gate_lib — running quality steps without fleet boilerplate." >&2
	cd "$(git rev-parse --show-toplevel)"
	run_step() {
		local name="$1"
		shift
		echo "→ ${name}"
		"$@"
	}
fi
# The caller verifies live draft+preview PR/head context through GitHub before
# using this shortcut. The scope guard independently rejects non-UI deltas.
if [[ "${FLEET_UI_PREVIEW:-0}" == 1 ]]; then
	if [[ ! -f "$gate_lib" ]]; then
		echo "✗ UI preview requires the shared gate's secrets/bootstrap checks." >&2
		exit 1
	fi
	run_step "UI preview scope" node scripts/ui-preview-scope.mjs
	run_step "UI preview checks" npm run check:preview
	echo "✓ preview checks passed — full gate and required ci still needed before ready/merge."
	exit 0
fi
run_step "biome ci"  npx --no-install biome ci . --error-on-warnings
run_step "yaml lint" npm run check:yaml
run_step "knip" npm run check:knip
run_step "legacy redirects" npm run redirects:check   # legacy/blogthedata/vercel.json matches url-map.json
run_step "recipe data" npm run recipes:check   # public/recipes/data matches recipes.json
run_step "actionlint"             npm run check:actions
run_step "markdown lint" npm run check:md
run_step "smoke scenario" npm run smoke:scenario-contract
run_step "types (astro + svelte)" npm run check:ts
run_step "unit tests" npm test
run_step "build"     npm run build
run_step "built tests" npm run test:built

echo "✓ pre-commit gate passed — commit will land; Vercel deploys via GitHub integration after merge to main."
