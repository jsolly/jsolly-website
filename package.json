{
	"name": "jsolly-website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"worktree:init": "bash gate/setup-agent-environment.sh",
		"browser:install": "node gate/provision-chromium.ts",
		"browser:check": "node gate/provision-chromium.ts --check",
		"dev": "astro dev --config config/app/astro.ts",
		"build": "node build/check-blog-media.mjs && astro build --config config/app/astro.ts && node --import ./build/register-ts-from-js.mjs build/markdown-build.mjs && node build/recipes/pwa-build.mjs && node tests/run-tests.mjs csp",
		"build:maintenance": "MAINTENANCE_MODE=true npm run build",
		"preview": "astro preview --config config/app/astro.ts",
		"lint": "biome lint --config-path=config/quality/biome.settings.jsonc --no-errors-on-unmatched",
		"format": "biome format --config-path=config/quality/biome.settings.jsonc --no-errors-on-unmatched --write",
		"check:ts": "astro check --config config/app/astro.ts --minimumSeverity error --minimumFailingSeverity error && svelte-check --tsconfig ./tsconfig.json --threshold error && node node_modules/@typescript/native/bin/tsc --project config/typescript/recipe-domain.json && node node_modules/@typescript/native/bin/tsc --project config/typescript/test-network.json && node node_modules/@typescript/native/bin/tsc --project config/typescript/recipe-image-diagnostics.json && node node_modules/@typescript/native/bin/tsc --project config/typescript/recipe-update-reporting.json && node node_modules/@typescript/native/bin/tsc --project tests/network/browser-controls/tsconfig.dedicated.json && node node_modules/@typescript/native/bin/tsc --project tests/network/browser-controls/tsconfig.shared.json && node node_modules/@typescript/native/bin/tsc --project tests/network/browser-controls/tsconfig.service.json && node node_modules/@typescript/native/bin/tsc --project tests/network/browser-controls/tsconfig.imported.json",
		"check:knip": "knip --config config/quality/knip.json --no-progress",
		"test": "node tests/run-tests.mjs unit",
		"test:python": "uvx --from pytest==9.1.1 pytest -c config/testing/pytest.ini",
		"test:built": "node tests/run-tests.mjs built",
		"redirects:write": "node build/blogthedata-redirects.mjs --write",
		"redirects:check": "node build/blogthedata-redirects.mjs --check",
		"recipes:sync": "node src/components/recipes/tools/sync-assistant-data.mjs",
		"recipes:check": "node src/components/recipes/tools/sync-assistant-data.mjs --check",
		"check:md": "bash gate/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -c config/quality/yamllint.yaml -s .",
		"check:fix": "biome check --config-path=config/quality/biome.settings.jsonc --write --no-errors-on-unmatched --error-on-warnings",
		"fix": "npm run check:fix && npm run check:ts",
		"outdated": "npm outdated",
		"update": "npx --yes npm-check-updates -u && npm install",
		"check:actions": "bash gate/check-actions.sh && node tests/run-tests.mjs workflow",
		"gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
		"smoke:production": "node tests/run-tests.mjs production",
		"smoke:scenario-contract": "node tests/run-tests.mjs smoke",
		"recipes:usda": "node src/components/recipes/tools/usda.mjs",
		"check:a11y": "node monitoring/check-accessibility.ts",
		"check:a11y:sample": "node monitoring/check-accessibility.ts --sample",
		"check:security": "python3 gate/security-scan.py ci"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-satteri": "0.4.3",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/ts-plugin": "^1.11.0",
		"@biomejs/biome": "2.6.4",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "2.16.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"@vercel/config": "0.14.1",
		"@vercel/routing-utils": "6.6.1",
		"@vercel/speed-insights": "2.0.0",
		"astro": "~7.4.7",
		"axe-core": "^4.14.0",
		"entities": "8.1.0",
		"esbuild": "0.28.2",
		"globby": "^16.2.4",
		"jsdom": "^31.0.0",
		"knip": "^6.37.0",
		"markdownlint-cli2": "^0.23.3",
		"parse5": "8.0.1",
		"playwright": "1.63.0",
		"sanitize-html": "2.18.1",
		"sharp": "0.35.5",
		"svelte-check": "4.7.8",
		"tailwindcss": "^4.3.3",
		"turndown": "7.2.4",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"yaml": "2.9.1"
	},
	"overrides": {
		"esbuild": "$esbuild",
		"undici": "^8.12.3",
		"ajv": ">=8.18.0",
		"smol-toml": "^1.9.0",
		"micromark-extension-math": {
			"katex": "^0.18.2"
		},
		"yaml": "$yaml",
		"@vercel/config": {
			"zod": "$zod"
		},
		"js-yaml@^4.0.0": "^4.3.2",
		"fast-uri": "^3.1.9",
		"http-cache-semantics": "^4.3.0",
		"markdown-it": "^15.0.3",
		"vite": "^8.3.5",
		"@vercel/routing-utils": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"zod@4.1.11": "4.6.7"
	},
	"dependencies": {
		"@astrojs/svelte": "9.1.2",
		"@aws-sdk/client-cloudwatch-logs": "3.1165.0",
		"@lucide/svelte": "1.51.0",
		"@vercel/edge": "^1.3.3",
		"@vercel/firewall": "1.2.6",
		"@vercel/oidc-aws-credentials-provider": "3.3.16",
		"bits-ui": "2.21.0",
		"clsx": "2.1.1",
		"minisearch": "7.2.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "4.0.0",
		"zod": "4.6.7"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"esbuild@0.28.2": true
	}
}
