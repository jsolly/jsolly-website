{
	"name": "jsolly-website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"worktree:init": "bash scripts/setup-agent-environment.sh",
		"dev": "astro dev --config config/app/astro.ts",
		"build": "astro build --config config/app/astro.ts && node --import ./scripts/register-ts-from-js.mjs scripts/markdown-build.mjs && node scripts/recipes/pwa-build.mjs && node scripts/run-tests.mjs csp",
		"build:maintenance": "MAINTENANCE_MODE=true npm run build",
		"preview": "astro preview --config config/app/astro.ts",
		"lint": "biome lint --config-path=config/quality/biome.settings.jsonc --no-errors-on-unmatched",
		"format": "biome format --config-path=config/quality/biome.settings.jsonc --no-errors-on-unmatched --write",
		"check:ts": "astro check --config config/app/astro.ts --minimumSeverity error --minimumFailingSeverity error && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"check:knip": "knip --config config/quality/knip.json --no-progress",
		"test": "node scripts/run-tests.mjs unit",
		"test:python": "uvx --from pytest==9.1.1 pytest -c config/testing/pytest.ini",
		"test:built": "node scripts/run-tests.mjs built",
		"redirects:write": "node scripts/blogthedata-redirects.mjs --write",
		"redirects:check": "node scripts/blogthedata-redirects.mjs --check",
		"recipes:sync": "node scripts/recipes/sync-assistant-data.mjs",
		"recipes:check": "node scripts/recipes/sync-assistant-data.mjs --check",
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -c config/quality/yamllint.yaml -s .",
		"check:fix": "biome check --config-path=config/quality/biome.settings.jsonc --write --no-errors-on-unmatched --error-on-warnings",
		"fix": "npm run check:fix && npm run check:ts",
		"outdated": "npm outdated",
		"update": "npx --yes npm-check-updates -u && npm install",
		"check:actions": "bash scripts/check-actions.sh && node scripts/run-tests.mjs workflow",
		"gate": "FLEET_UI_PREVIEW=0 FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
		"smoke:production": "node scripts/run-tests.mjs production",
		"smoke:scenario-contract": "node scripts/run-tests.mjs smoke",
		"recipes:usda": "node scripts/recipes/usda.mjs",
		"check:preview": "npx --no-install biome ci --config-path=config/quality/biome.settings.jsonc . --error-on-warnings && npm run check:ts && npm test",
		"gate:preview": "FLEET_UI_PREVIEW=1 FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
		"check:a11y": "node scripts/check-accessibility.mjs",
		"check:a11y:sample": "node scripts/check-accessibility.mjs --sample",
		"check:security": "python3 scripts/security-scan.py ci"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-satteri": "0.4.3",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/ts-plugin": "^1.10.12",
		"@biomejs/biome": "2.5.14",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sanitize-html": "2.16.2",
		"@vercel/routing-utils": "6.6.0",
		"astro": "~7.3.8",
		"axe-core": "^4.14.0",
		"entities": "8.1.0",
		"esbuild": "0.28.1",
		"globby": "^16.2.4",
		"jsdom": "^30.1.1",
		"knip": "^6.37.0",
		"markdownlint-cli2": "^0.23.3",
		"parse5": "8.0.1",
		"playwright": "1.63.0",
		"sanitize-html": "2.18.1",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.3.3",
		"turndown": "7.2.4",
		"typescript": "^6.0.3",
		"vercel": "^63.1.2",
		"vitest": "5.0.5",
		"yaml": "2.9.1"
	},
	"overrides": {
		"esbuild": "$esbuild",
		"@tootallnate/once": ">=2.0.1",
		"minimatch": ">=10.2.3",
		"tar": ">=7.5.11",
		"undici": "^8.12.3",
		"ajv": ">=8.18.0",
		"smol-toml": "^1.9.0",
		"micromark-extension-math": {
			"katex": "^0.18.2"
		},
		"srvx": ">=0.11.13",
		"yaml": "$yaml",
		"@vercel/node": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/remix-builder": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/routing-utils": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/backends": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/express": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/fun": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/hono": {
			"path-to-regexp": ">=8.4.0"
		},
		"js-yaml@^4.0.0": "^4.3.2",
		"fast-uri": "^3.1.9",
		"http-cache-semantics": "^4.3.0",
		"markdown-it": "^15.0.3",
		"vite": "^8.3.5",
		"zod@4.1.11": "4.6.7"
	},
	"dependencies": {
		"@astrojs/svelte": "9.0.1",
		"@aws-sdk/client-cloudwatch-logs": "3.1150.0",
		"@lucide/svelte": "1.51.0",
		"@vercel/edge": "^1.3.3",
		"@vercel/oidc-aws-credentials-provider": "3.3.13",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"minisearch": "7.2.0",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.1",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"zod": "4.6.7"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
