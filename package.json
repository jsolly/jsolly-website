{
	"name": "jsolly-website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"worktree:init": "npm ci",
		"dev": "astro dev",
		"prebuild": "node scripts/gen-release-id.mjs",
		"build": "astro build && node process-html.mjs",
		"postbuild": "node scripts/restore-release-stub.mjs",
		"build:maintenance": "MAINTENANCE_MODE=true astro build && node process-html.mjs",
		"preview": "astro preview",
		"prepare": "if [ -z \"$CI\" ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath .git-hooks; fi",
		"lint": "biome lint --no-errors-on-unmatched",
		"format": "biome format --no-errors-on-unmatched --write",
		"check:ts": "astro check --minimumSeverity warning --minimumFailingSeverity warning",
		"test": "node --import ./scripts/register-ts-from-js.mjs --experimental-strip-types --test src/lib/*.test.ts",
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -s .",
		"check:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings",
		"check:release-id": "node scripts/check-release-id.mjs",
		"fix": "npm run check:fix && npm run check:ts",
		"outdated": "npm outdated",
		"update": "npx npm-check-updates -u && npm install",
		"check:actions": "bash scripts/check-actions.sh"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/ts-plugin": "^1.10.11",
		"@biomejs/biome": "2.5.11",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "~7.2.10",
		"github-actionlint": "^1.7.12",
		"globby": "^16.2.4",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^30.0.1",
		"markdownlint-cli2": "^0.23.2",
		"sharp": "^0.35.3",
		"shellcheck": "^4.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vercel": "^59.10.0"
	},
	"overrides": {
		"esbuild": ">=0.28.1",
		"@tootallnate/once": ">=2.0.1",
		"minimatch": ">=10.2.3",
		"tar": ">=7.5.11",
		"undici": ">=6.24.0",
		"ajv": ">=8.18.0",
		"smol-toml": ">=1.6.1",
		"srvx": ">=0.11.13",
		"yaml": ">=2.8.3",
		"@vercel/node": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/remix-builder": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/backends": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/express": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/fun": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/hono": {
			"path-to-regexp": ">=8.4.0"
		}
	},
	"dependencies": {
		"@vercel/edge": "^1.3.3"
	}
}
