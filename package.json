{
	"name": "jsolly-website",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"worktree:init": "npm ci",
		"dev": "astro dev",
		"build": "astro build && node process-html.mjs && node --import ./scripts/register-ts-from-js.mjs scripts/markdown-build.mjs && node scripts/recipes/pwa-build.mjs && node scripts/run-tests.mjs csp",
		"build:maintenance": "MAINTENANCE_MODE=true npm run build",
		"preview": "astro preview",
		"lint": "biome lint --no-errors-on-unmatched",
		"format": "biome format --no-errors-on-unmatched --write",
		"check:ts": "astro check --minimumSeverity error --minimumFailingSeverity error && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"check:knip": "knip --no-progress",
		"test": "node scripts/run-tests.mjs unit",
		"test:built": "node scripts/run-tests.mjs built",
		"redirects:write": "node scripts/blogthedata-redirects.mjs --write",
		"redirects:check": "node scripts/blogthedata-redirects.mjs --check",
		"recipes:sync": "node scripts/recipes/sync-assistant-data.mjs",
		"recipes:check": "node scripts/recipes/sync-assistant-data.mjs --check",
		"check:md": "bash scripts/lint-md.sh",
		"check:yaml": "uvx yamllint@1.38.0 -s .",
		"check:fix": "biome check --write --no-errors-on-unmatched --error-on-warnings",
		"fix": "npm run check:fix && npm run check:ts",
		"outdated": "npm outdated",
		"update": "npx --yes npm-check-updates -u && npm install",
		"check:actions": "bash scripts/check-actions.sh && bash scripts/vercel-preview-comment-contract.sh && bash scripts/vercel-preview-workflow-contract.sh",
		"gate": "FLEET_DOC_FAST=0 bash .git-hooks/pre-commit",
		"smoke:production": "node scripts/production-smoke.mjs",
		"smoke:scenario-contract": "node scripts/run-tests.mjs smoke",
		"recipes:usda": "node scripts/recipes/usda.mjs"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/markdown-satteri": "0.4.2",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/ts-plugin": "^1.10.12",
		"@aws-sdk/client-ssm": "^3.1149.0",
		"@aws-sdk/client-sts": "^3.1149.0",
		"@biomejs/biome": "2.5.14",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/poppins": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@tailwindcss/node": "^4.3.3",
		"@tailwindcss/oxide": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sanitize-html": "2.16.2",
		"@vercel/routing-utils": "6.6.0",
		"astro": "~7.3.5",
		"entities": "8.1.0",
		"esbuild": "0.28.1",
		"globby": "^16.2.4",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^30.1.1",
		"knip": "^6.37.0",
		"markdownlint-cli2": "^0.23.3",
		"playwright": "1.63.0",
		"sanitize-html": "2.18.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "^4.3.3",
		"turndown": "7.2.4",
		"typescript": "^6.0.3",
		"vercel": "^59.17.0",
		"yaml": "2.9.1"
	},
	"overrides": {
		"esbuild": "$esbuild",
		"@tootallnate/once": ">=2.0.1",
		"minimatch": ">=10.2.3",
		"tar": ">=7.5.11",
		"undici": ">=6.24.0",
		"ajv": ">=8.18.0",
		"smol-toml": "^1.9.0",
		"micromark-extension-math": {
			"katex": "^0.18.2"
		},
		"srvx": ">=0.11.13",
		"yaml": "$yaml",
		"@vercel/node": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/remix-builder": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/routing-utils": {
			"path-to-regexp": ">=6.3.0 <7.0.0"
		},
		"@vercel/backends": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/express": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/fun": {
			"path-to-regexp": ">=8.4.0"
		},
		"@vercel/hono": {
			"path-to-regexp": ">=8.4.0"
		},
		"js-yaml@^4.0.0": "^4.3.2"
	},
	"dependencies": {
		"@astrojs/svelte": "9.0.1",
		"@lucide/svelte": "1.51.0",
		"@vercel/edge": "^1.3.3",
		"bits-ui": "2.19.5",
		"clsx": "2.1.1",
		"minisearch": "7.2.0",
		"shadcn-svelte": "1.3.0",
		"svelte": "5.57.1",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"zod": "4.6.5"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
