---
// Blog and recipe metadata remain section-specific; the visual shell is shared
// with the portfolio. Article styles stay scoped to the reading section.

import SiteShell from "../components/SiteShell.astro";
import Button from "../lib/components/ui/button.svelte";
import "../styles/blog/blog.css";
import BlogNavigation from "../components/blog/BlogNavigation.svelte";
import { markdownSiblingPath } from "../lib/accept-negotiate.js";
import {
	DEFAULT_IMAGE,
	EMBED_HOSTS,
	FEEDS,
	LEGACY_MEDIA,
} from "../lib/blog/constants.js";
import { blogNavigation } from "../lib/blog/content.js";
import noScriptStyles from "../styles/blog/no-script.css?url";

interface Props {
	title: string;
	section: "blog" | "recipes";
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	article?: boolean;
}

const {
	title,
	section,
	description = "Articles about geospatial development, web development, AI and productivity by John Solly.",
	image = DEFAULT_IMAGE,
	imageAlt = "John Solly",
	noindex = false,
	article = false,
} = Astro.props;

// Post bodies load legacy images from CloudFront (J6) and embed YouTube,
// diagrams.net and nbviewer frames; only blog pages widen the Astro meta
// policy, and a build without CSP must fail rather than ship without it.
if (section === "blog") {
	if (!Astro.csp) {
		throw new Error(
			"BlogLayout: Astro.csp is unavailable; enable security.csp in astro.config.ts",
		);
	}
	Astro.csp.insertDirective(
		`img-src 'self' data: ${new URL(LEGACY_MEDIA).origin}`,
	);
	Astro.csp.insertDirective(
		`frame-src ${EMBED_HOSTS.map((host) => `https://${host}`).join(" ")}`,
	);
}

const isMaintenanceMode = process.env.MAINTENANCE_MODE === "true";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const navigation = await blogNavigation();
const isRecipeCollection = ["/recipes/", "/recipes/meals/", "/recipes/smoothies/"].includes(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | John Solly</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{!isMaintenanceMode && <link rel="alternate" type="text/markdown" href={markdownSiblingPath(Astro.url.pathname)} />}
		<link rel="icon" href="/favicon.ico" />
		{
			Object.values(FEEDS).map(({ path, type, title: feedTitle }) => (
				<link rel="alternate" type={type} title={feedTitle} href={path} />
			))
		}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<noscript><link rel="stylesheet" href={noScriptStyles} /></noscript>
		{!isMaintenanceMode && <slot name="head" />}
	</head>
  <body id="top" class="bg-background text-text-primary font-body">
    <SiteShell {section}>
      {section === "blog"
        ? <BlogNavigation slot="navigation" categories={navigation} pathname={Astro.url.pathname} client:load />
        : !isRecipeCollection && <nav slot="navigation" class="blog-toolbar recipe-navigation" aria-label="Recipe navigation">
            <Button href="/recipes/meals/" variant="outline" size="lg">Meals</Button>
            <Button href="/recipes/smoothies/" variant="outline" size="lg">Smoothies</Button>
          </nav>}

      <slot />
      <nav slot="section-footer" class="section-footer" aria-label={section === "blog" ? "Blog resources" : "Recipe resources"}>
        {section === "blog" && <>
          <a href="/blog/all-posts/">All posts</a>
          <a href="/blog/works-cited/">Works cited</a>
          <a href={FEEDS.rss.path}>RSS</a>
          <a href={FEEDS.atom.path}>Atom</a>
        </>}
        <a href="#top">Back to top</a>
      </nav>
    </SiteShell>
  </body>
</html>

<style>
@layer properties, theme, base, components, utilities, blog, blog-no-script;
@layer blog {
.recipe-navigation { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-start; padding-block: 16px; }
.recipe-navigation :global(a) { min-height: 44px; padding: 10px 20px; border: 1px solid var(--recipe-line); background: var(--recipe-paper); color: var(--recipe-ink); font-weight: 650; text-decoration: none; }
.recipe-navigation :global(a:hover) { background: var(--recipe-soft); color: var(--recipe-ink); text-decoration: none; }
}
</style>
