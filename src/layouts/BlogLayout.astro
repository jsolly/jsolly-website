---
// The blog and recipes layout, ported from awesome-blog's Base.astro. It is
// standalone: the portfolio's Layout.astro advertises Markdown alternates these
// pages do not have (plan J11), and the blog keeps its own stylesheets.
import "@fontsource/inter/400.css";
import "@fontsource/inter/600.css";
import "@fontsource/poppins/600.css";
import "@fontsource/poppins/700.css";
import "../styles/blog/theme.css";
import "../styles/blog/ui.css";
import "../styles/blog/blog.css";
import BlogNavigation from "../components/blog/BlogNavigation.svelte";
import Maintenance from "../components/Maintenance.astro";
import {
	DEFAULT_IMAGE,
	EMBED_HOSTS,
	LEGACY_MEDIA,
} from "../lib/blog/constants.js";
import { blogNavigation } from "../lib/blog/content.js";
import noScriptStyles from "../styles/blog/no-script.css?url";

interface Props {
	title: string;
	section: "blog" | "recipes";
	description?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
	article?: boolean;
}

const {
	title,
	section,
	description = "Articles about geospatial development, web development, AI and productivity by John Solly.",
	image = DEFAULT_IMAGE,
	imageAlt = "John Solly",
	noindex = false,
	article = false,
} = Astro.props;

// Post bodies load legacy images from CloudFront (J6) and embed YouTube,
// diagrams.net and nbviewer frames; only blog pages widen the Astro meta
// policy, and a build without CSP must fail rather than ship without it.
if (section === "blog") {
	if (!Astro.csp) {
		throw new Error(
			"BlogLayout: Astro.csp is unavailable; enable security.csp in astro.config.ts",
		);
	}
	Astro.csp.insertDirective(
		`img-src 'self' data: ${new URL(LEGACY_MEDIA).origin}`,
	);
	Astro.csp.insertDirective(
		`frame-src ${EMBED_HOSTS.map((host) => `https://${host}`).join(" ")}`,
	);
}

const isMaintenanceMode = process.env.MAINTENANCE_MODE === "true";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
const navigation = await blogNavigation();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | Blogthedata</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.ico" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={article ? "article" : "website"} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<noscript><link rel="stylesheet" href={noScriptStyles} /></noscript>
		<slot name="head" />
	</head>
	<body id="top">
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<div class="header-inner">
				<a class="brand" href="/blog/"
					><img
						src="/blog/topographic-logo.svg"
						alt=""
						width="40"
						height="40"
					/>Solly's Blog</a
				>
				<BlogNavigation
					categories={navigation}
					pathname={Astro.url.pathname}
					client:load
				/>
			</div>
		</header>
		<div class="page-layout" data-page={Astro.url.pathname}>
			<main id="main">{isMaintenanceMode ? <Maintenance /> : <slot />}</main>
		</div>
		<footer class="site-footer">
			<nav aria-label="Footer"
				><a href="/blog/">Home</a><a href="/blog/all-posts/">All posts</a><a
					href="/privacy/">Privacy</a
				><a href="/blog/works-cited/">Works cited</a><a href="/blog/rss.xml"
					>RSS</a
				><a href="/blog/atom.xml">Atom</a><a href="#top">Back to top</a></nav
			>
			<p>Designed &amp; built by John Solly</p>
		</footer>
	</body>
</html>
