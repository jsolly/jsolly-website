---
// The layout of every recipe page: BlogLayout's recipes section, the recipe
// stylesheet and the offline recipe app (its head tags and RecipePwa). A
// maintenance build shows none of it: BlogLayout drops the head slot and
// swaps the page body for the notice, and scripts/recipes/pwa-build.mjs
// writes no worker.
//
// BlogLayout is imported first: Astro orders a page's stylesheets by import
// position, and the blog sheets come before the recipe sheets, as when the
// pages imported BlogLayout directly.
import BlogLayout from "./BlogLayout.astro";
import "../styles/recipes/recipes-theme.css";
import {
	PWA_FILES_PATH,
	PWA_NAME,
	PWA_THEME_COLOR,
} from "../components/recipes/constants.mjs";
import RecipePwa from "../components/recipes/RecipePwa.astro";
import noScriptStyles from "../styles/recipes/page-no-script.css?url";

interface Props {
	title: string;
	description: string;
	article?: boolean;
	noindex?: boolean;
	image?: string;
	imageAlt?: string;
}

const { title, description, article = false, noindex = false, image, imageAlt } = Astro.props;
---

<BlogLayout section="recipes" {title} {description} {article} {noindex} {...(image === undefined ? {} : { image })} {...(imageAlt === undefined ? {} : { imageAlt })}>
	<Fragment slot="head">
		<link rel="related" type="application/json" href="/recipes/data/recipe-library.json" title="Complete recipe library: ingredients, instructions, nutrition and sources" />
		<link rel="help" type="text/plain" href="/llms.txt" title="Agent reading guide" />
		<noscript><link rel="stylesheet" href={noScriptStyles} /></noscript>
		<link rel="manifest" href={`${PWA_FILES_PATH}manifest.webmanifest`} />
		<meta name="theme-color" content={PWA_THEME_COLOR} />
		<link rel="apple-touch-icon" href={`${PWA_FILES_PATH}icon-180.png`} />
		<meta name="apple-mobile-web-app-title" content={PWA_NAME} />
	</Fragment>
	<RecipePwa />
	<slot />
</BlogLayout>
