---
import type { InferGetStaticPropsType } from "astro";
import RecipePage from "../../components/recipes/RecipePage.svelte";
import data from "../../components/recipes/recipes.json" with { type: "json" };
import RecipeLayout from "../../layouts/RecipeLayout.astro";

// One page per recipe at /recipes/<id>/, the same path as on blogthedata.com.
// Its section id is the recipe id, so old /recipes/<id>/#<id> links still land.
export function getStaticPaths() {
	return data.recipes.map((entry) => ({
		params: { slug: entry.id },
		props: { recipe: entry },
	}));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { recipe } = Astro.props;
---

<RecipeLayout title={recipe.title} description={recipe.summary} article>
	<RecipePage {recipe} client:load />
</RecipeLayout>
