---
import type { InferGetStaticPropsType } from "astro";
import Breadcrumbs from "../../components/blog/Breadcrumbs.astro";
import RecipePage from "../../components/recipes/RecipePage.svelte";
import data from "../../components/recipes/recipe-data.server.mjs";
import { recipeStructuredData } from "../../components/recipes/recipe-structured-data.mjs";
import retiredRecipes from "../../components/recipes/retired-recipes.json" with { type: "json" };
import RecipeLayout from "../../layouts/RecipeLayout.astro";
import { breadcrumbList, jsonLd } from "../../lib/blog/structured-data.js";

// One page per recipe at /recipes/<id>/, the same path as on blogthedata.com.
// Its section id is the recipe id, so old /recipes/<id>/#<id> links still land.
export function getStaticPaths() {
	return [
		...data.recipes.map((item) => ({
			params: { slug: item.id },
			props: { kind: "recipe" as const, recipe: item },
		})),
		...retiredRecipes.map((item) => ({
			params: { slug: item.id },
			props: { kind: "retired" as const, retired: item },
		})),
	];
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const entry = Astro.props;
const recipe = entry.kind === "recipe" ? entry.recipe : null;
const retired = entry.kind === "retired" ? entry.retired : null;
const collection = (recipe?.type ?? retired?.type) === "smoothie" ? "smoothies" : "meals";
const replacement = retired?.replacementId
	? data.recipes.find(({ id }) => id === retired.replacementId)
	: null;
const site = Astro.site ?? new URL("https://www.jsolly.com/");
const crumbs = recipe ? [
	{ name: "Home", href: "/" },
	{ name: "Recipes", href: "/recipes/" },
	{ name: collection === "smoothies" ? "Keto smoothies" : "Keto meals", href: `/recipes/${collection}/` },
	{ name: recipe.title, href: `/recipes/${recipe.id}/` },
] : [];
const breadcrumb = jsonLd(breadcrumbList(crumbs, site));
const structured = recipe ? jsonLd(recipeStructuredData(recipe, site)) : "";
---

{recipe ? (
	<RecipeLayout title={recipe.title} description={recipe.summary} image={recipe.image.src} imageAlt={recipe.image.alt} article>
		<Fragment slot="head">
			<!-- jsonLd escapes authored text for script embedding. -->
			<script type="application/ld+json" set:html={structured} />
			<!-- jsonLd escapes authored text for script embedding. -->
			<script type="application/ld+json" set:html={breadcrumb} />
		</Fragment>
		<Breadcrumbs {crumbs} />
		<RecipePage {recipe} client:load />
	</RecipeLayout>
) : retired && (
	<RecipeLayout title={retired.title} description="This original recipe is outside the keto collection. Browse keto alternatives." noindex>
		<article id={retired.id}>
			<h1>{retired.title}</h1>
			<p>This recipe is no longer in the keto collection because its original version exceeds the collection's carbohydrate limit.</p>
			<p>Choose a keto recipe from the links below.</p>
			{replacement && <p>Try a keto alternative: <a href={`/recipes/${replacement.id}/`}>{replacement.title}</a>.</p>}
			<p><a href={`/recipes/${collection}/`}>Browse keto {collection}</a></p>
		</article>
	</RecipeLayout>
)}
