---
import ContactMe from "../components/ContactMe.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { ROLE } from "../content/constants.js";
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="Contact John Solly — Enterprise Health CTO & Software Engineer"
	description={`Get in touch with John Solly, ${ROLE} and software engineer — reach out about spatial computing, AI, or federal health IT.`}
>
	<section class="mx-auto max-w-2xl py-8 text-center">
		<h1
			class="text-text-primary font-heading mb-6 text-3xl font-bold tracking-tight md:text-4xl"
		>
			Contact
		</h1>
		<p class="text-text-secondary mb-6 text-lg">
			Reach out about spatial computing, GIS, applied AI, or federal health IT
			(SSA, VA, HHS). I am glad to hear from other technical leaders and from
			engineers who care about craft. There is no public inbox on this site —
			use Say Hello below, or find me on the profiles listed here.
		</p>
		<p class="text-text-secondary mb-6 text-lg">Find me across the web:</p>
		<div class="flex justify-center">
			<SocialLinks imgLoading="eager" />
		</div>
	</section>
	<ContactMe />
</Layout>
