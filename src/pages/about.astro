---
import { Image } from "astro:assets";
import ContactMe from "../components/ContactMe.astro";
import SocialLinks from "../components/SocialLinks.astro";
// Static Images
import jsollyImage from "../images/jsolly.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="About John Solly — Health-IT Division CTO at Leidos"
    description="John Solly is the Health-IT Division CTO at Leidos and a software engineer with experience spanning startups, Fortune 500s, federal agencies, and universities."
>
    <div
        class="about-section bg-subtle-dark-overlay-lvl-2 text-text rounded-lg shadow-lg p-6 mx-auto"
    >
        <div class="profile flex flex-col md:flex-row items-center">
            <Image
                src={jsollyImage}
                alt="John Solly Avatar"
                class="rounded-full mb-4 md:mb-0 md:mr-6 w-48"
                loading="eager"
                fetchpriority="high"
            />
            <div>
                <h1
                    class="text-2xl font-bold text-text leading-none tracking-tight"
                >
                    John Solly
                </h1>
                <p class="text-text leading-relaxed tracking-wide">
                    Health-IT Division CTO & Software Engineer
                </p>
                <div class="social-links flex mt-3">
                    <SocialLinks imgLoading="eager" />
                </div>
            </div>
        </div>
        <div class="about-content mt-4 text-xl">
            <p>
                A hands-on AI practitioner who transitioned to a CTO role to
                broaden my impact.
            </p>
            <p>
                Most of my career has been dedicated to developing spatial
                systems at Esri, startups, and federal agencies. Currently, I
                lead technology strategy for Leidos' Health IT division,
                supporting agencies such as SSA, VA, and HHS.
            </p>
            <p>
                My primary focus is the convergence of spatial computing and AI,
                enabling machines to interpret the physical world and applying
                these capabilities to meaningful missions.
            </p>
            <p>
                Please <a href="/contact/" class="text-accent underline"
                    >reach out</a
                > if you are interested in spatial systems or advancing AI
                within the federal government.
            </p>
        </div>
    </div>
    <ContactMe />
</Layout>

<style>
    .about-content p + p {
        margin-top: 16px;
    }

    .about-section {
        background-color: rgba(0, 0, 0, 0.05);
        color: #171717;
        border-radius: 0.5rem;
        box-shadow:
            0 10px 15px -3px rgba(0, 0, 0, 0.1),
            0 4px 6px -2px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
        margin: 0 auto;
    }

    .social-links {
        display: flex;
        margin-top: 0.75rem;
    }
</style>
