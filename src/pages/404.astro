---
import { Image } from "astro:assets";
import ScarecrowImg from "../images/scarecrow.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout noindex title="404 Not Found" description="Page not found">
	<div class="flex flex-col items-center text-center">
		<header class="my-8">
			<span class="text-accent text-4xl font-bold"> 404 NOT FOUND</span>
		</header>
		<Image
			src={ScarecrowImg}
			alt=""
			width="300"
			height="300"
			class="rounded-lg shadow-lg"
		/>
		<section class="mt-8">
			<h1 class="mt-8 text-5xl font-bold tracking-tighter">
				I have bad news for you...
			</h1>
			<p class="text-text mt-4 text-lg">
				The page you are looking for might be removed or is temporarily
				unavailable.
			</p>
			<nav
				class="mx-auto mt-6 max-w-md text-left"
				aria-label="Suggested next steps"
			>
				<p class="text-text mb-2 text-lg">Try one of these instead:</p>
				<ul class="text-text list-disc space-y-1 pl-6 text-lg">
					<li><a href="/">Home</a></li>
					<li><a href="/about/">About</a></li>
					<li><a href="/contact/">Contact</a></li>
					<li>
						<a href="/llms.txt">Agent index (llms.txt)</a>
					</li>
					<li>
						<a href="/sitemap-index.xml">Sitemap</a>
					</li>
					<li>
						<a
							href="/John-Solly-Resume.pdf"
							target="_blank"
							rel="noopener noreferrer">Resume</a
						>
					</li>
				</ul>
			</nav>
		</section>
		<footer class="mt-8">
			<p class="text-text text-xs">
				404 page by
				<a
					href="https://github.com/OnlyManu/"
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-accent transition-colors duration-300 ease-in-out"
					>onlymanu</a
				>
			</p>
		</footer>
	</div>
</Layout>
