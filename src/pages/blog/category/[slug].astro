---
import type { InferGetStaticPropsType } from "astro";
import PostCards from "../../../components/blog/PostCards.svelte";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { cards } from "../../../lib/blog/cards.js";
import { POSTS_PER_BATCH } from "../../../lib/blog/constants.js";
import { blogContent } from "../../../lib/blog/content.js";

export async function getStaticPaths() {
	const content = await blogContent();
	return content.categories.map((entry) => ({
		params: { slug: entry.data.slug },
		props: {
			category: entry,
			posts: cards(
				content.posts.filter((post) => post.data.category === entry.data.slug),
			),
		},
	}));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, posts } = Astro.props;
---
<BlogLayout title={category.data.name} description={category.data.description} section="blog"><h1>{category.data.name}</h1><p>{category.data.description}</p>{category.data.slug === "resources" && <p><a href="/recipes/">Recipes</a> — easy meals and smoothies with cooking tools.</p>}{posts.length ? <PostCards posts={posts} pageSize={POSTS_PER_BATCH} client:load /> : <p>No posts in this category yet.</p>}</BlogLayout>
