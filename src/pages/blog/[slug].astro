---
import type { InferGetStaticPropsType } from "astro";
import AuthorCard from "../../components/blog/AuthorCard.astro";
import PostCards from "../../components/blog/PostCards.svelte";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { cards, dateLabel } from "../../lib/blog/cards.js";
import { blogContent } from "../../lib/blog/content.js";
import {
	articleHtml,
	headingId,
	headingLinkLabel,
	imageUrl,
} from "../../lib/blog/html.js";
import { categoryHref, postHref } from "../../lib/blog/urls.js";

// One page per published post at /blog/<slug>/ (slug case kept). A related
// slug naming a draft is left out of the cards; one naming no post at all has
// already failed the build in publishedContent.
export async function getStaticPaths() {
	const { posts } = await blogContent();
	const bySlug = new Map(posts.map((entry) => [entry.data.slug, entry]));
	return posts.map((entry) => ({
		params: { slug: entry.data.slug },
		props: {
			post: entry,
			related: cards(
				entry.data.related.flatMap((slug) => bySlug.get(slug) ?? []),
			),
		},
	}));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

// JSON in an inline <script> must not contain "</script"; post titles and
// descriptions are authored text that may hold "<", so every "<" is escaped.
const LESS_THAN = /</gu;

// The share links, in order: each opens the target's share form for the
// post's jsolly.com URL in a new tab.
const SHARE_TARGETS = [
	{
		name: "X",
		icon: "xLogo.svg",
		href: (postUrl: string, postTitle: string) =>
			`https://twitter.com/intent/tweet/?text=${encodeURIComponent(postTitle)}&url=${encodeURIComponent(postUrl)}`,
	},
	{
		name: "Reddit",
		icon: "redditLogo.svg",
		href: (postUrl: string, postTitle: string) =>
			`https://www.reddit.com/submit?url=${encodeURIComponent(postUrl)}&title=${encodeURIComponent(postTitle)}`,
	},
	{
		name: "LinkedIn",
		icon: "linkedinLogo.svg",
		href: (postUrl: string) =>
			`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(postUrl)}`,
	},
];

const { post, related } = Astro.props;
const { data, html, categoryName } = post;
const image = imageUrl(data.image);
const url = new URL(postHref(data.slug), Astro.site).href;
const categoryPage = categoryHref(data.category);
const titleId = headingId(data.title);
const structured = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: data.title,
	description: data.description,
	image: new URL(image, Astro.site).href,
	datePublished: data.published.toISOString(),
	dateModified: data.updated.toISOString(),
	author: { "@type": "Person", name: data.author },
	mainEntityOfPage: url,
}).replace(LESS_THAN, "\\u003c");
---
<BlogLayout title={data.title} description={data.description} image={image} imageAlt={data.imageAlt} section="blog" article>
	<Fragment slot="head">
		<meta property="article:published_time" content={data.published.toISOString()} />
		<meta property="article:modified_time" content={data.updated.toISOString()} />
		<!-- biome-ignore lint/nursery/noAstroSetHtmlDirective: first-party JSON-LD must stay raw JSON; every "<" is escaped above -->
		<script type="application/ld+json" set:html={structured} />
	</Fragment>
	<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/blog/">Home</a><span aria-hidden="true">/</span><a href={categoryPage}>{categoryName}</a></nav>
	<article>
		<h1 id={titleId}>{data.title}<a class="heading-link" href={`#${titleId}`} aria-label={headingLinkLabel(data.title)}>#</a></h1>
		<figure><img class="article-hero" src={image} alt={data.imageAlt} width={data.imageWidth ?? undefined} height={data.imageHeight ?? undefined} fetchpriority="high" />{data.imageAttribution && <figcaption>{data.imageAttribution}</figcaption>}</figure>
		<!-- biome-ignore lint/nursery/noAstroSetHtmlDirective: articleHtml returns sanitize-html output (src/lib/blog/html.ts) -->
		<div class="article-body post-text" set:html={articleHtml(html)} />
		<footer class="post-details">
			<p class="post-meta"><time datetime={data.published.toISOString()}>{dateLabel(data.published)}</time> in <a href={categoryPage}>{categoryName}</a></p>
			<p class="post-meta">Updated <time datetime={data.updated.toISOString()}>{dateLabel(data.updated)}</time></p>
			<div class="article-actions share-actions"><span class="action-label">Share</span><button id="print-article" type="button">Print this post</button>{SHARE_TARGETS.map(({ name, icon, href }) => <a class="action-button" href={href(url, data.title)} rel="noopener noreferrer" target="_blank"><img src={`/blog/social/${icon}`} alt={`Share on ${name} (opens in new tab)`} width="22" height="22" /></a>)}</div>
		</footer>
	</article>
	<div class="article-actions"><a class="action-button" href="/blog/">Back to home</a><span id="heading-copy-status" role="status" /></div>
	{related.length > 0 && <section class="related-posts"><h2>Related posts</h2><PostCards posts={related} headingTag="h3" /></section>}
	<AuthorCard />
</BlogLayout>
<script>
	const COPIED = "Heading link copied.";
	// How long the copy message stays before the status region empties.
	const ANNOUNCE_MS = 3000;
	let clearTimer: number | undefined;

	// Empties the status region, then fills it on the next frame, so a screen
	// reader announces every copy (not only the first); it empties again later.
	function announceCopy(status: Element) {
		window.clearTimeout(clearTimer);
		status.textContent = "";
		requestAnimationFrame(() => {
			status.textContent = COPIED;
			clearTimer = window.setTimeout(() => {
				status.textContent = "";
			}, ANNOUNCE_MS);
		});
	}

	// Copies the heading's address on the post's canonical (jsolly.com) URL,
	// whichever host serves the page.
	async function copyHeadingLink(link: HTMLAnchorElement) {
		const canonical =
			document.querySelector<HTMLLinkElement>("link[rel=canonical]")?.href ??
			window.location.href;
		try {
			await navigator.clipboard.writeText(
				new URL(link.getAttribute("href") ?? "", canonical).href,
			);
			const status = document.querySelector("#heading-copy-status");
			if (status) announceCopy(status);
		} catch {
			// Following the fragment still works without clipboard permission.
		}
	}

	document
		.querySelector("#print-article")
		?.addEventListener("click", () => window.print());
	for (const link of document.querySelectorAll<HTMLAnchorElement>(
		".heading-link",
	)) {
		link.addEventListener("click", () => {
			void copyHeadingLink(link);
		});
	}
</script>
