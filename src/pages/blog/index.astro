---
import PostCards from "../../components/blog/PostCards.svelte";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { cards } from "../../lib/blog/cards.js";
import { POSTS_PER_BATCH } from "../../lib/blog/constants.js";
import { blogContent } from "../../lib/blog/content.js";

const { posts } = await blogContent();
---
<BlogLayout title="Solly's Blog" section="blog">
<!-- Preserve the former author-card bookmark target without rendering the card. -->
<span id="about-author" aria-hidden="true"></span><h1>Latest Posts!</h1><PostCards posts={cards(posts)} pageSize={POSTS_PER_BATCH} client:load /></BlogLayout>
