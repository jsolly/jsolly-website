---
import AuthorCard from "../../components/blog/AuthorCard.astro";
import PostCards from "../../components/blog/PostCards.svelte";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { cards } from "../../lib/blog/cards.js";
import { blogContent } from "../../lib/blog/content.js";

const { posts } = await blogContent();
---
<BlogLayout title="Solly's Blog" section="blog"><AuthorCard /><h1>Latest Posts!</h1><PostCards posts={cards(posts)} pageSize={3} client:load /></BlogLayout>
