---
import SocialLinks from "./SocialLinks.astro";
---

<footer class="mt-16 md:mt-24 pb-8">
	<div class="border-t border-border pt-8">
		<div class="flex flex-col md:flex-row justify-between items-center gap-8">
			<nav class="flex flex-wrap justify-center gap-8" aria-label="Footer navigation">
				<a href="/about/" class="text-lg font-medium text-text-secondary hover:text-primary-600 transition-colors" aria-label="About John Solly">About</a>
				<a href="/contact/" class="text-lg font-medium text-text-secondary hover:text-primary-600 transition-colors" aria-label="Contact John Solly">Contact</a>
				<a href="/blog/" class="text-lg font-medium text-text-secondary hover:text-primary-600 transition-colors" aria-label="Read John Solly's blog">Blog</a>
				<a href="/recipes/" class="text-lg font-medium text-text-secondary hover:text-primary-600 transition-colors" aria-label="Browse John Solly's recipes">Recipes</a>
				<a href="/John-Solly-Resume.pdf" target="_blank" rel="noopener noreferrer" class="text-lg font-medium text-text-secondary hover:text-primary-600 transition-colors" aria-label="Download John Solly's resume (opens in new tab)">Resume</a>
			</nav>
			<SocialLinks />
		</div>
		<p class="text-center text-text-muted mt-8 text-sm">
			&copy; {new Date().getFullYear()} John Solly.
			<a href="/privacy/" class="hover:text-primary-600 transition-colors underline">Privacy</a>
			·
			<a href="/terms/" class="hover:text-primary-600 transition-colors underline">Terms</a>
		</p>
	</div>
</footer> 
