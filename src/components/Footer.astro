---
import { siteLinks } from "../content/constants.js";
import SocialLinks from "./SocialLinks.astro";
---

<footer class="site-footer mt-16 md:mt-24 pb-8">
	<div class="border-t border-border pt-8">
		<div class="flex flex-col md:flex-row justify-between items-center gap-8">
			<nav class="flex flex-wrap justify-center gap-8" aria-label="Footer navigation">
				{
					
					siteLinks.map((link) => (
						<a
							href={link.href}
							target={link.target}
							rel={link.rel}
							class="font-medium text-lg text-text-secondary transition-colors hover:text-primary-600"
							aria-label={link.label}
						>
							{link.text}
						</a>
					))
				}
			</nav>
			<SocialLinks />
		</div>
		<p class="text-center text-text-muted mt-8 text-sm">
			&copy; {new Date().getFullYear()} John Solly.
			<a href="/privacy/" class="hover:text-primary-600 transition-colors underline">Privacy</a>
			·
			<a href="/terms/" class="hover:text-primary-600 transition-colors underline">Terms</a>
		</p>
	</div>
</footer> 
