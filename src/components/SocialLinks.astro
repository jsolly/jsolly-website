---
import { Image } from "astro:assets";
import { socialLinks } from "../content/socialLinks.js";

interface Props {
	imgLoading?: "eager" | "lazy";
}

const { imgLoading = "lazy" } = Astro.props;
---

<nav class="flex gap-6" aria-label="Social media links">
	{
		socialLinks.map((link) => (
			<a
				href={link.href}
				target="_blank"
				rel={link.rel}
				class="social-link opacity-80 transition-all duration-300 ease-in-out hover:scale-110 hover:opacity-100"
				aria-label={link.ariaLabel}
			>
				<Image src={link.icon} alt={link.alt} loading={imgLoading} />
			</a>
		))
	}
</nav>

<style>
	@layer components {
		/* Hide the global external-link indicator on icon-only social links */
		a[target="_blank"].social-link::after {
			content: none;
		}
	}
</style>
