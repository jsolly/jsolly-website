---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { socialLinks } from "../content/constants.js";
import type { SocialIcon } from "../content/types.js";
import githubLogo from "../images/social/githubLogo.svg";
import linkedinLogo from "../images/social/linkedinLogo.svg";
import xLogo from "../images/social/xLogo.svg";
import youtubeLogo from "../images/social/youtubeLogo.svg";

interface Props {
	imgLoading?: "eager" | "lazy";
}

const { imgLoading = "lazy" } = Astro.props;
const ICONS: Record<SocialIcon, ImageMetadata> = {
	github: githubLogo,
	linkedin: linkedinLogo,
	x: xLogo,
	youtube: youtubeLogo,
};
---

<nav class="flex gap-6" aria-label="Social media links">
	{
		socialLinks.map((link) => (
			<a
				href={link.href}
				target="_blank"
				rel={link.rel}
				class="social-link opacity-80 transition-all duration-300 ease-in-out hover:scale-110 hover:opacity-100"
				aria-label={link.ariaLabel}
			>
				<Image src={ICONS[link.icon]} alt={link.alt} loading={imgLoading} />
			</a>
		))
	}
</nav>

<style>
	@layer components {
		/* Hide the global external-link indicator on icon-only social links */
		a[target="_blank"].social-link::after {
			content: none;
		}
	}
</style>
