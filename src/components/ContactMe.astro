---
import Button from "../lib/components/ui/button.svelte";
---
<section
    class="from-primary-50/30 via-accent-50/20 to-primary-100/30 my-8 rounded-2xl border-y border-neutral-200 bg-gradient-to-br py-16"
    aria-labelledby="contact-me-heading"
>
    <div class="mx-auto max-w-3xl text-center">
        <h2
            id="contact-me-heading"
            class="font-heading text-text-primary mb-4 text-4xl leading-none font-bold tracking-tighter md:text-5xl"
        >
            Let's Connect
        </h2>
        <p class="text-text-secondary mb-8 text-left text-xl leading-relaxed tracking-wide">
            I'm always happy to meet other technical leaders, engineers who care
            about craft, or anyone thinking about similar problems. Drop me a
            line.
        </p>
        <div class="text-center">
            <Button
                rel="noopener noreferrer"
                target="_blank"
                href="https://us14.list-manage.com/contact-form?u=3fb3f4adf8ab2cd1ebd6ff743&form_id=7c78cd242677faaebfc3d4a2bc0d5fda"
                class="primary-btn inline-block h-auto transform rounded-xl border-0 px-6 py-3 text-base font-semibold transition-all duration-400 ease-out hover:scale-105"
                aria-label="Say Hello to John"
            >
                Say Hello
            </Button>
        </div>
    </div>
</section>
