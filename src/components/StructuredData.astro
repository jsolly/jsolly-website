---
import { socialLinks } from "../content/socialLinks";

const site = Astro.site ?? new URL("https://www.jsolly.com/");
const origin = site.origin;
const personId = `${origin}/#person`;
const websiteId = `${origin}/#website`;

const organizationId = `${origin}/#organization`;
const contactUrl = `${origin}/contact/`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": websiteId,
			url: `${origin}/`,
			name: "John Solly",
			description:
				"Personal website of John Solly — Health-IT Division CTO at Leidos and software engineer.",
			inLanguage: "en-US",
			publisher: { "@id": organizationId },
		},
		{
			"@type": "Organization",
			"@id": organizationId,
			name: "John Solly",
			url: `${origin}/`,
			logo: `${origin}/images/og-image.jpg`,
			description:
				"Personal website of John Solly — Health-IT Division CTO at Leidos, software engineer, and builder of spatial and AI systems.",
			sameAs: socialLinks.map((link) => link.href),
			contactPoint: {
				"@type": "ContactPoint",
				contactType: "customer support",
				url: contactUrl,
				availableLanguage: "English",
			},
			address: {
				"@type": "PostalAddress",
				addressCountry: "US",
			},
		},
		{
			"@type": "Person",
			"@id": personId,
			name: "John Solly",
			url: `${origin}/`,
			image: `${origin}/images/og-image.jpg`,
			jobTitle: "Health-IT Division CTO at Leidos",
			description:
				"Health-IT Division CTO at Leidos leading digital modernization for federal health and benefits agencies; software engineer and builder.",
			sameAs: socialLinks.map((link) => link.href),
			contactPoint: {
				"@type": "ContactPoint",
				contactType: "customer support",
				url: contactUrl,
			},
		},
	],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
