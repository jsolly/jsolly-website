---
// The recipe app's status line, which recipe-pwa-client.mjs keeps current
// while it installs and updates the service worker. RecipeLayout renders it
// on every recipe page, with the app's manifest and icons in the head. The
// aside is visible offline and hidden online. Preview builds omit the status
// element so the client never registers a cache-first offline worker there.
const isPreview = import.meta.env.VERCEL_ENV === "preview";
---

{!isPreview && <aside class="recipe-pwa" hidden>
	<p id="recipe-offline-status" role="status">Save recipes to your home screen. On iPhone or iPad, open in Safari and choose Share → Add to Home Screen. Other browsers offer Install or Add to Home Screen in their menu.</p>
	<p>Recipe tools and illustrations work offline once saved. External source links and other blog pages need a connection.</p>
</aside>}
<script>
	import "./recipe-pwa-client.mjs";
</script>
