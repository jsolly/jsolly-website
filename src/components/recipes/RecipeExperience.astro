---
// The recipe library island with its no-JavaScript fallback styles, on
// /recipes/ and the meals and smoothies pages. `collection` picks the cards
// shown first; every page passes all 21 recipes, so a #<recipe-id> link opens
// any recipe, smoothies included (plan §1.6).
import noScriptStyles from "../../styles/recipes/recipes-no-script.css?url";
import RecipeLibrary from "./RecipeLibrary.svelte";
import data from "./recipes.json" with { type: "json" };

interface Props {
	collection?: "meal" | "smoothie";
}

const { collection = "meal" } = Astro.props;
---

<noscript><link rel="stylesheet" href={noScriptStyles} /></noscript>
<div class="recipe-experience"><RecipeLibrary recipes={data.recipes} initialCollection={collection} pathname={Astro.url.pathname} client:load /></div>
