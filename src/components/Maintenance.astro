---
/**
 * Maintenance mode page displayed when MAINTENANCE_MODE env var is set to "true".
 * Replaces all page content with a simple maintenance notice.
 */
---

<div class="min-h-maintenance flex items-center justify-center px-4">
	<div class="max-w-lg text-center">
		<div class="bg-primary-100 mb-8 inline-flex size-20 items-center justify-center rounded-full">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="text-primary-600 size-10"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l5.653-4.655m4.093-4.093l5.653-4.655a2.548 2.548 0 113.586 3.586l-4.655 5.653m-4.093-4.093L9.7 9.7m4.093 4.093L9.7 9.7"
				/>
			</svg>
		</div>

		<h1 class="font-heading text-text-primary mb-4 text-4xl font-bold tracking-tight md:text-5xl">
			Under Maintenance
		</h1>

		<p class="text-text-secondary mb-8 text-lg leading-relaxed md:text-xl">
			I'm making some improvements to the site. Please check back shortly.
		</p>

		<div class="text-text-muted bg-primary-100 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm">
			<span class="relative flex size-2">
				<span class="bg-warning absolute inline-flex size-full animate-ping rounded-full opacity-75"></span>
				<span class="bg-warning relative inline-flex size-2 rounded-full"></span>
			</span>
			Work in progress
		</div>
	</div>
</div>
