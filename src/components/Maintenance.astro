---
/**
 * Maintenance mode page displayed when MAINTENANCE_MODE env var is set to "true".
 * Replaces all page content with a simple maintenance notice.
 */
---

<div class="min-h-[80vh] flex items-center justify-center px-4">
	<div class="text-center max-w-lg">
		<div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-primary-100 mb-8">
			<svg
				xmlns="http://www.w3.org/2000/svg"
				class="w-10 h-10 text-primary-600"
				fill="none"
				viewBox="0 0 24 24"
				stroke="currentColor"
				stroke-width="1.5"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l5.653-4.655m4.093-4.093l5.653-4.655a2.548 2.548 0 113.586 3.586l-4.655 5.653m-4.093-4.093L9.7 9.7m4.093 4.093L9.7 9.7"
				/>
			</svg>
		</div>

		<h1 class="text-4xl md:text-5xl font-heading font-bold text-text-primary tracking-tight mb-4">
			Under Maintenance
		</h1>

		<p class="text-lg md:text-xl text-text-secondary leading-relaxed mb-8">
			I'm making some improvements to the site. Please check back shortly.
		</p>

		<div class="inline-flex items-center gap-2 text-sm text-text-muted bg-primary-100 px-4 py-2 rounded-full">
			<span class="relative flex h-2 w-2">
				<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-warning opacity-75"></span>
				<span class="relative inline-flex rounded-full h-2 w-2 bg-warning"></span>
			</span>
			Work in progress
		</div>
	</div>
</div>
