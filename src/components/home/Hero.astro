---
import { Image } from "astro:assets";
import { EMPLOYER, ROLE, ROLE_PREFIX } from "../../content/constants.js";
import jsollyLarge from "../../images/jsollyLarge.webp";
import Button from "../../lib/components/ui/button.svelte";
---

<article class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-8 px-4 md:grid-cols-2 md:gap-12">
    <header class="order-2 space-y-8 md:order-1">
        <div class="space-y-4">
            <h1 id="hero-heading" class="text-text-primary text-5xl leading-tight font-bold tracking-tighter md:text-7xl">
                Hi, I'm <span class="text-gradient">John Solly</span>.
            </h1>
            <div class="to-primary-900 h-1 w-24 rounded-full bg-gradient-to-r from-blue-500" aria-hidden="true"></div>
        </div>
        
        <!-- Enhanced bio with better typography -->
        <p class="text-text-secondary max-w-lg text-xl leading-relaxed md:text-2xl">
            {ROLE_PREFIX} <span class="text-accent-primary font-semibold">{EMPLOYER}</span>, leading digital modernization for federal health and benefits agencies.
        </p>
        
        <!-- Enhanced CTA buttons with better styling -->
        <nav class="flex flex-col gap-4 pt-4 sm:flex-row" aria-label="Call to action">
            <Button
                href="/about/"
                class="primary-btn group h-auto rounded-xl border-0 px-6 py-3 text-center text-base font-semibold"
            >
                More About Me
                <span class="ml-2 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </Button>
        </nav>
    </header>
    
    <!-- Enhanced image container with better styling -->
    <figure class="order-1 flex justify-center md:order-2 md:justify-end">
        <div class="relative">
            <!-- Decorative background elements -->
            <div class="from-primary-100 to-accent-100 absolute inset-0 animate-pulse rounded-full bg-gradient-to-br opacity-30 blur-3xl" aria-hidden="true"></div>
            <div class="absolute inset-0 rounded-full bg-gradient-to-br from-neutral-200 to-neutral-300 opacity-20 blur-2xl" aria-hidden="true"></div>
            
            <!-- Main image with enhanced styling -->
            <Image
                src={jsollyLarge}
                alt={`John Solly - ${ROLE}`}
                class="ring-primary-100 hover:ring-primary-200 relative size-56 rounded-full border-4 border-white object-cover shadow-2xl ring-4 transition-all duration-500 hover:scale-105 md:size-72"
                loading="eager"
                fetchpriority="high"
                widths={[288, 576]}
                sizes="(max-width: 768px) 224px, 288px"
            />
        </div>
    </figure>
</article> 