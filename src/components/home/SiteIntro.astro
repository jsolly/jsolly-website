---
import { MARKDOWN_GUIDANCE } from "../../content/agent-pages.js";
import {
	BLOG_DESCRIPTION,
	RECIPES_DESCRIPTION,
	ROLE,
	ROLE_STRATEGY,
} from "../../content/constants.js";

const origin = Astro.site?.origin ?? "https://www.jsolly.com";
---

<section class="max-w-3xl py-8 md:py-4" aria-labelledby="about-this-site-heading">
	<h2
		id="about-this-site-heading"
		class="text-text-primary font-heading mb-4 text-3xl font-bold tracking-tight md:text-4xl"
	>
		About this site
	</h2>
	<p class="text-text-secondary mb-4 text-lg leading-relaxed">
		jsolly.com is the personal website of John Solly, {ROLE}. It is a small
		static site: who I am, how to reach me, my blog and recipes, and pointers
		to work I publish elsewhere. It is not a Leidos corporate page and it does
		not ship a product API.
	</p>
	<p class="text-text-secondary mb-8 text-lg leading-relaxed">
		Most of my career has been building spatial systems — at Esri, startups, and
		federal agencies. I now {ROLE_STRATEGY}, supporting agencies such as SSA,
		VA, and HHS. My focus is the convergence of spatial computing and AI:
		helping machines interpret the physical world and putting that to work on
		missions that matter.
	</p>

	<h3
		id="pages-on-this-site-heading"
		class="text-text-primary font-heading mb-3 text-xl font-bold tracking-tight"
	>
		Pages
	</h3>
	<ul class="text-text-secondary mb-8 list-disc space-y-2 pl-6 text-lg leading-relaxed">
		<li>
			<a href="/about/">About</a> — background, focus areas, and how I got here
		</li>
		<li>
			<a href="/contact/">Contact</a> — social profiles and a contact form
		</li>
		<li>
			<a href="/privacy/">Privacy</a> — data practices for this static site
		</li>
		<li>
			<a href="/terms/">Terms</a> — a short, permissive note about using this site
		</li>
		<li>
			<a href="/John-Solly-Resume.pdf" target="_blank" rel="noopener noreferrer"
				>Resume</a
			>
			(PDF)
		</li>
		<li>
			<a href="/blog/">Blog</a> — {BLOG_DESCRIPTION}
		</li>
		<li>
			<a href="/recipes/">Recipes</a> — {RECIPES_DESCRIPTION}
		</li>
	</ul>

	<h3
		id="for-agents-heading"
		class="text-text-primary font-heading mb-3 text-xl font-bold tracking-tight"
	>
		For agents
	</h3>
	<p class="text-text-secondary text-lg leading-relaxed">
		Start at
		<a href={`${origin}/llms.txt`}>{origin}/llms.txt</a>
		for when-to-use guidance. Request a page with
		<code class="text-base">Accept: text/markdown</code>
		(or fetch its
		<code class="text-base">.md</code>
		sibling) to get a Markdown body without the layout chrome. {MARKDOWN_GUIDANCE}
		Missing paths return HTTP 404 with recovery links to
		the sitemap and that index.
	</p>
</section>
