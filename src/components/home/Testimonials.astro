---
import { Image } from "astro:assets";
import AmyBrazilAvatar from "/src/images/AmyBrazil.webp";
import CraigUtleyAvatar from "/src/images/CraigUtley.webp";
import KathrynThorpeAvatar from "/src/images/KathrynThorpe.webp";
import MeredithBeanAvatar from "/src/images/MeredithBean.webp";
import TaylorOshanAvatar from "/src/images/TaylorOshan.svg";

const testimonials = [
	{
		avatar: TaylorOshanAvatar,
		name: "Taylor Oshan",
		position: "Direct Manager",
		company: "University of Maryland",
		quote: "John is a talented geospatial developer and a capable leader",
	},
	{
		avatar: AmyBrazilAvatar,
		name: "Amy Brazil",
		position: "Direct Manager",
		company: "YellowfinBI",
		quote: "I'd hire him back in a heartbeat.",
	},
	{
		avatar: CraigUtleyAvatar,
		name: "Craig Utley",
		position: "Direct Manager",
		company: "YellowfinBI",
		quote: "John delivered for customers, and earned the respect of his peers",
	},
	{
		avatar: MeredithBeanAvatar,
		name: "Meredith Bean",
		position: "Undergraduate Student",
		company: "GMU",
		quote:
			"John was an extraordinary TA to me as a student in an introductory GIS class.",
	},
	{
		avatar: KathrynThorpeAvatar,
		name: "Kathryn Thorpe",
		position: "Coworker",
		company: "YellowfinBI",
		quote: "John is amazingly bright, levelheaded, and goal-oriented.",
	},
];
---

<section aria-labelledby="testimonials-heading">
	<header class="mb-12 text-center">
		<div class="flex items-center justify-center gap-4 mb-2">
			<div class="w-10 h-px bg-primary-400"></div>
			<span class="text-xs font-semibold uppercase tracking-[0.2em] text-text-muted font-heading">What people say</span>
			<div class="w-10 h-px bg-primary-400"></div>
		</div>
		<h2 id="testimonials-heading" class="text-3xl md:text-4xl font-bold text-text-primary font-heading tracking-tight">
			Testimonials
		</h2>
	</header>

	<ul class="testimonial-grid" role="list">
		{testimonials.map((t, i) => (
			<li class="testimonial-card" style={`--delay: ${i * 80}ms`}>
				<blockquote class="testimonial-quote">
					<p><span class="quote-mark" aria-hidden="true">&ldquo;</span>{t.quote}<span class="quote-mark" aria-hidden="true">&rdquo;</span></p>
				</blockquote>
				<footer class="testimonial-attribution">
					<Image
						src={t.avatar}
						alt=""
						width={44}
						height={44}
						densities={[1, 2]}
						class="testimonial-avatar"
					/>
					<div>
						<cite class="testimonial-name">{t.name}</cite>
						<p class="testimonial-role">{t.position}, {t.company}</p>
					</div>
				</footer>
			</li>
		))}
	</ul>
</section>

<style>
	.testimonial-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	@media (min-width: 640px) {
		.testimonial-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 1024px) {
		.testimonial-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	.testimonial-card {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: 1.25rem 1.5rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		background: var(--color-card);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
		animation: cardReveal 0.5s ease both;
		animation-delay: var(--delay);
		overflow: visible;
	}

	.testimonial-card:hover {
		border-color: var(--color-primary-300);
		box-shadow: var(--shadow-soft);
	}

	.testimonial-quote p {
		text-indent: -0.6em;
		padding-left: 0.6em;
	}

	.quote-mark {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.75rem;
		line-height: 0;
		vertical-align: -0.1em;
		color: var(--color-primary-300);
		user-select: none;
	}

	.testimonial-quote {
		position: relative;
		z-index: 1;
		margin: 0 0 1.25rem;
		flex: 1;
	}

	.testimonial-quote p {
		font-family: Georgia, "Times New Roman", serif;
		font-style: italic;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.testimonial-attribution {
		display: flex;
		align-items: start;
		gap: 0.75rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border);
		min-height: 4.5rem;
	}

	.testimonial-avatar {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 9999px;
		object-fit: cover;
		flex-shrink: 0;
		border: 2px solid var(--color-primary-100);
	}

	.testimonial-name {
		display: block;
		font-family: var(--font-family-heading);
		font-style: normal;
		font-weight: 600;
		font-size: 0.875rem;
		color: var(--color-text-primary);
		line-height: 1.3;
	}

	.testimonial-role {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		margin: 0;
		line-height: 1.4;
	}

	@media (prefers-reduced-motion: reduce) {
		.testimonial-card {
			animation: none;
		}
	}

	@keyframes cardReveal {
		from {
			transform: translateY(8px);
		}
		to {
			transform: translateY(0);
		}
	}
</style>
