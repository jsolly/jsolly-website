{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"root": ".",
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		// Parse the complete canonical library and its all-serving measurement audit.
		"maxSize": 8388608,
		"includes": [
			"**",
			"!.agents",
			// Recipe provenance evidence (J17), kept byte-for-byte as recorded.
			"!docs/recipes-evidence",
			// Generated by npm run recipes:sync; --write would reformat
			// recipe-library.json and break recipes:check.
			"!public/recipes/data",
			// nbconvert output, kept as rendered.
			"!public/notebooks",
			"!**/*.svg",
			"**/*.ts",
			"**/*.js",
			"**/*.json",
			"**/*.jsonc",
			"**/*.mjs",
			"**/*.css",
			"**/*.html",
			"**/*.md"
		],
		"ignoreUnknown": true
	},
	// Markdown remains owned by markdownlint. Biome 2.6 formatting removes required blank lines.
	"markdown": { "formatter": { "enabled": false } },
	"css": {
		"parser": {
			// Tailwind CSS 4 directives (@theme, @utility, @apply) — required since Biome 2.5
			"tailwindDirectives": true
		}
	},
	"html": {
		// Resolves `.astro` / `astro:assets` for project-domain + a11y rules
		"experimentalFullSupportEnabled": true
	},
	"linter": {
		"domains": {
			"types": "all",
			"project": "all",
			"astro": "all",
			"tailwind": "all",
			"test": "all"
		},
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error",
				"useAwaitThenable": "error",
				"useModernMathApis": "error",
				"useIncludes": "error",
				"useFlatMathMinMax": "error",
				"noUnmodifiedLoopCondition": "error",
				"useBetterDomTraversing": "error",
				"useLayeredStyles": {
					"level": "error",
					"options": { "requireImportLayers": false }
				},
				"useNamedLayer": "error",
				"noNegationInEqualityCheck": "error",
				"noXorAsExponentiation": "error",
				"noBaseToString": "error",
				"noMisleadingReturnType": "error",
				"noUnsafePlusOperands": "error",
				"noUselessTypeConversion": "error",
				"useDisposables": "error",
				"useNullishCoalescing": "error",
				"useRegexpExec": "error",
				"useStringStartsEndsWith": "error",
				"noImpliedEval": "error",
				"noUnsafeTypeAssertion": "error",
				"noExtendNative": "error",
				"noInvalidPropertyInitValue": "error",
				// HOLD: does not see Tailwind 4 `@theme` tokens declared in another CSS file.
				"noUndeclaredCustomProperties": "off",
				"noObsoleteTags": "error",
				"noNonScalableViewport": "error",
				"noInvalidFileInputAccept": "error",
				"noUnsafeIframeSandbox": "error",
				"useControlLabel": "error",
				"noReturnInFinally": "error",
				"noJsonUnsafeValues": "error",
				"noAstroSetHtmlDirective": "error",
				"useAstroClientOnlyDirectiveValue": "error",
				"noTailwindArbitraryValue": "error",
				"useTailwindShorthandClasses": "error",
				// HOLD: flags `RegExp#test()` as a Jest `test()` call.
				"useValidTestTitle": "off",
				"noThisOutsideOfClass": "error",
				// Tailwind 4 utilities are generated; noUnusedClasses does not treat
				// .astro class= as HTML/JSX (biome#9156).
				"noUndeclaredClasses": "off",
				"noUnusedClasses": "off",
				"useTailwindSortedClasses": {
					"level": "error"
				}
				// Skipped (style-only or wrong runner): useBaseline, useExplicitType,
				// useExplicitReturnType, useConsistentFunctionStyle, useExpect (node:assert).
			},
			"security": {
				"noSecrets": "error",
				"noScriptUrl": "error",
				"noGlobalEval": "error",
				"useIframeSandbox": "error"
			},
			"a11y": {
				"noAmbiguousAnchorText": "error",
				"noAriaHiddenOnFocusable": "error",
				"noStaticElementInteractions": "error",
				"noNoninteractiveElementInteractions": "error",
				"noPositiveTabindex": "error",
				"useFocusableInteractive": "error",
				"useSemanticElements": "error",
				"useGenericFontNames": "error",
				"useValidAutocomplete": "error"
			},
			"suspicious": {
				"noUnnecessaryConditions": "error",
				"noImportCycles": "error",
				"useArraySortCompare": "error",
				"noShadow": "error",
				"noNestedPromises": "error",
				"noDeprecatedImports": "error",
				"noDuplicateDependencies": "error",
				"noEvolvingTypes": "error",
				"noImplicitAnyLet": "error",
				"noTsIgnore": "error",
				"noUnassignedVariables": "error",
				"useAwait": "error",
				"noDuplicateTestHooks": "error",
				"noFocusedTests": "error",
				"noMisplacedAssertion": "error",
				"noExportsInTest": "error",
				"noConstantBinaryExpressions": "error",
				"noUselessEscapeInString": "error",
				"noAlert": "error",
				"noDocumentCookie": "error",
				"noEmptyBlock": "error",
				"noEmptyBlockStatements": "error",
				"noEqualsToNull": "error",
				"noForIn": "error",
				"noPrototypeBuiltins": "error",
				"noThenProperty": "error",
				"noApproximativeNumericConstant": "error",
				"noAssignInExpressions": "error",
				"noAsyncPromiseExecutor": "error",
				"noControlCharactersInRegex": "error",
				"noConfusingVoidType": "error",
				"noDoubleEquals": "error",
				"noFallthroughSwitchClause": "error",
				"noOctalEscape": "error",
				"noRedeclare": "error",
				"noSelfCompare": "error",
				"noShadowRestrictedNames": "error",
				"noSparseArray": "error",
				"noTemplateCurlyInString": "error",
				"noUnusedExpressions": "error",
				"noUselessRegexBackrefs": "error",
				"useAdjacentOverloadSignatures": "error",
				"useDefaultSwitchClauseLast": "error",
				"useErrorMessage": "error",
				"useGetterReturn": "error",
				"useGuardForIn": "error",
				"useIsArray": "error",
				"useIterableCallbackReturn": "error",
				"useNamespaceKeyword": "error",
				"useNumberToFixedDigitsArgument": "error",
				"noUndeclaredEnvVars": {
					"level": "error",
					"options": {
						"allowedEnvVars": [
							"MAINTENANCE_MODE",
							"VERCEL_GIT_COMMIT_SHA",
							"GITHUB_SHA",
							"NODE_ENV",
							"CI"
						]
					}
				},
				"noLoopFunc": "error",
				"noEmptyObjectKeys": "error",
				"noDuplicateSelectors": "error",
				"noIdenticalTestTitle": "error",
				"noConditionalExpect": "error"
			},
			"correctness": {
				// HOLD: TypeScript / astro check is first-class for module resolution.
				// Biome cannot resolve jsdom CJS or astro:assets SVG default exports.
				"noUnresolvedImports": "off",
				"noUnusedInstantiation": "error",
				"noUndeclaredDependencies": "error",
				"noPrivateImports": "error",
				"noConstantMathMinMaxClamp": "error",
				"noGlobalDirnameFilename": "error",
				"noUnusedFunctionParameters": "error",
				"useImportExtensions": {
					"level": "error",
					"options": {
						// Do not rewrite `.svg` / `.astro` / `.css` to `.js`.
						"forceJsExtensions": false,
						"extensionMappings": {
							"ts": "js",
							"mts": "js",
							"cts": "js"
						}
					}
				},
				"useJsonImportAttributes": "error",
				"useImageSize": "error",
				"useUniqueElementIds": "error",
				"useParseIntRadix": "error",
				"useIsNan": "error",
				"useYield": "error"
			},
			"complexity": {
				"useArrayFind": "error",
				"useDateNow": "error",
				"useOptionalChain": "error",
				"useFlatMap": "error",
				"useIndexOf": "error",
				"noUselessUndefined": "error",
				"noUselessStringConcat": "error",
				"noUselessTernary": "error",
				"noExtraBooleanCast": "error",
				"noImplicitCoercions": "error",
				"useNumericLiterals": "error",
				"useRegexLiterals": "error",
				"useWhile": "error",
				"noFlatMapIdentity": "error",
				"noBannedTypes": "error",
				"noUselessCatch": "error",
				"noUselessContinue": "error",
				"noUselessRename": "error",
				"noUselessReturn": "error",
				"noUselessTypeConstraint": "error",
				"noUselessUndefinedInitialization": "error",
				"noUselessLoneBlockStatements": "error",
				"useLiteralKeys": "error",
				"useRegexpTest": "error",
				"useArraySome": "error",
				"useMathMinMax": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noExcessiveNestedCallbacks": "error",
				"noExcessiveSelectorClasses": "error"
			},
			"style": {
				"useErrorCause": "error",
				"useNodejsImportProtocol": "error",
				"useTrimStartEnd": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"useAtIndex": "error",
				"useExponentiationOperator": "error",
				"useDefaultSwitchClause": "error",
				"useDefaultParameterLast": "error",
				"useConsistentBuiltinInstantiation": "error",
				"noSubstr": "error",
				"useObjectSpread": "error",
				"useTemplate": "error",
				"useForOf": "error",
				"useCollapsedElseIf": "error",
				"useCollapsedIf": "error",
				"useExportType": "error",
				"useNodeAssertStrict": "error",
				"noYodaExpression": "error",
				"useSpreadOverApply": "error",
				"useSymbolDescription": "error",
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"useAsConstAssertion": "error",
				"useShorthandAssign": "error",
				"useEnumInitializers": "error",
				"useLiteralEnumMembers": "error",
				"useDomQuerySelector": "error",
				"useImportsFirst": "error",
				"useVarsOnTop": "error",
				"useUnicodeRegex": "error",
				"useNamedCaptureGroup": "error",
				"useReduceTypeParameter": "error",
				"useConsistentTestIt": "error",
				"useTestHooksInOrder": "error",
				"useTestHooksOnTop": "error",
				"noInlineStyles": "error",
				"useThisInClassMethods": "error"
			},
			"performance": {
				"noAwaitInLoops": "error",
				"noAccumulatingSpread": "error",
				"noBarrelFile": "error",
				"noDelete": "error",
				"noDynamicNamespaceImportAccess": "error",
				"noNamespaceImport": "error",
				"noSyncScripts": "error",
				"noReExportAll": "error",
				"useTopLevelRegex": "error",
				"useDomNodeTextContent": "error"
			}
		}
	},
	"overrides": [
		{
			// Node 26 executes these modules directly, including their typed dependencies.
			// Keep real .ts specifiers at this boundary; no JS output is generated.
			"includes": [
				"tests/network/**/*.ts",
				"tests/fixtures/transport-deadline/*.ts",
				"tests/unit/verify-blogthedata-transports.test.mjs",
				"tests/built/test-network.test.ts",
				"tests/unit/test-network.test.ts",
				"tests/run-tests.mjs",
				"tests/vercel-preview-workflow.test.mjs",
				"tests/unit/usda.test.mjs",
				"tests/unit/fake-aws-cli.mjs",
				"gate/ci-gate.mjs",
				"config/testing/vitest.config.mjs",
				"monitoring/accessibility-pages.ts",
				"monitoring/accessibility-report.mjs",
				"monitoring/check-accessibility.ts",
				"monitoring/constants.ts",
				"tests/built/accessibility-sample.test.mjs",
				"tests/built/asset-retention.test.mjs",
				"tests/built/blog-browse.test.mjs",
				"tests/built/blog-post.test.mjs",
				"tests/built/blog-search.test.mjs",
				"tests/built/blogthedata-killswitch.test.mjs",
				"tests/built/csp-browser.test.mjs",
				"tests/built/hydration.test.mjs",
				"tests/built/initial-render.test.mjs",
				"tests/built/keto-shared-table.test.mjs",
				"tests/built/mobile-menu-animation.test.mjs",
				"tests/built/production-smoke.test.mjs",
				"tests/built/recipe-card-images.test.mjs",
				"tests/built/recipe-native-browse.test.mjs",
				"tests/built/recipe-navigation.test.mjs",
				"tests/built/recipe-page.test.mjs",
				"tests/built/recipe-popover-loading.test.mjs",
				"tests/built/recipe-preferences.test.mjs",
				"tests/built/recipe-progressive-recovery.test.ts",
				"tests/built/recipe-image-diagnostics/*.ts",
				"tests/built/recipe-publication.test.mjs",
				"tests/built/recipe-search.test.mjs",
				"tests/built/recipe-units.test.mjs",
				"tests/built/recipes-browse.test.mjs",
				"tests/built/recipes-deep-links.test.mjs",
				"tests/built/recipes-library.test.mjs",
				"tests/built/recipes-nutrition-pills.test.mjs",
				"tests/built/recipes-preview.test.mjs",
				"tests/built/recipes-pwa-fixture.mjs",
				"tests/built/recipes-pwa-update.test.mjs",
				"tests/built/recipes-visited-offline.test.mjs",
				"tests/built/safari-print.test.mjs",
				"tests/built/site-update.test.mjs",
				"tests/fixtures/gate-browser-descendant.ts",
				"tests/production-smoke-scenario.test.mjs",
				"src/components/recipes/flow-equipment.test.mjs",
				"src/components/recipes/recipe-data.server.mjs",
				"src/components/recipes/recipe-browse.mjs"
			],
			"linter": {
				"rules": {
					"correctness": {
						"useImportExtensions": {
							"level": "error",
							"options": {
								"forceJsExtensions": false,
								"extensionMappings": { "ts": "ts" }
							}
						}
					}
				}
			}
		},
		{
			// Frozen pre-keto source registries retain their original bytes.
			// They remain parsed and linted, but are never reformatted.
			"includes": ["docs/recipes-archive/**/*.json"],
			"formatter": { "enabled": false }
		},
		{
			// These large data files use the migration/audit JSON.stringify layout.
			// Keep both formatting and lint checks without collapsing small arrays.
			"includes": [
				"src/components/recipes/recipes.json",
				"docs/recipe-units-audit.json"
			],
			"json": { "formatter": { "expand": "always" } }
		},
		{
			// PagesCMS owns these files: it rewrites each one with
			// JSON.stringify(x, null, 2) and no final newline. Linting stays on.
			"includes": ["src/content/blog/categories/**"],
			"formatter": { "enabled": false }
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"noUnusedFunctionParameters": "off",
						// React `useId()` — static Astro ids must stay stable for CSS/JS hooks.
						"useUniqueElementIds": "off"
					},
					"nursery": {
						"noUndeclaredClasses": "off",
						"noUnusedClasses": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"nursery": {
						"noUnusedClasses": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts"],
			"linter": {
				"rules": {
					"performance": {
						// Assertion regexes belong next to the case, not module scope.
						"useTopLevelRegex": "off"
					}
				}
			}
		}
	],
	"tailwind": { "attributes": ["class", "className"] }
}
