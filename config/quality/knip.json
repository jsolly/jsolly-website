{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"middleware.ts",
		"src/**/*.test.ts",
		"src/**/*.test.mjs",
		"tests/**/*.mjs",
		"gate/**/*.mjs",
		"monitoring/**/*.mjs",
		"tests/fixtures/gate-browser-descendant.ts",
		"tests/fixtures/transport-deadline/scenario.ts",
		"build/**/*.mjs",
		"src/components/recipes/tools/*.mjs",
		"api/**/*.mjs",
		"tests/network/node/preload.ts",
		"tests/network/node/controls/controller.ts",
		"tests/built/*.test.ts",
		"tests/network/browser-controls/fixtures/*.ts"
	],
	"ignore": ["legacy/blogthedata/public/**"],
	"ignoreBinaries": ["uvx"],
	"ignoreDependencies": ["markdownlint-cli2", "vercel"],
	"treatConfigHintsAsErrors": true,
	"vitest": {
		"config": [
			"config/testing/vitest.config.mjs",
			"config/testing/ci-built.config.mjs"
		]
	},
	"astro": {
		"config": ["config/app/astro.ts"]
	},
	"biome": {
		"config": ["config/quality/biome.settings.jsonc"]
	}
}
