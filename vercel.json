{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"trailingSlash": true,
	"git": {
		"deploymentEnabled": {
			"main": true,
			"*": false,
			"*/*": false,
			"*/*/*": false,
			"*/*/*/*": false,
			"**": false
		}
	},
	"redirects": [
		{
			"source": "/:path*",
			"has": [
				{
					"type": "host",
					"value": "jsolly.com"
				}
			],
			"destination": "https://www.jsolly.com/:path*",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Content-Security-Policy",
					"value": "img-src 'self' data: https://d1d7p8ufhgz4ld.cloudfront.net; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
				}
			]
		},
		{
			"source": "/blog/rss.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/rss+xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/blog/atom.xml",
			"headers": [
				{
					"key": "Content-Type",
					"value": "application/atom+xml; charset=utf-8"
				}
			]
		},
		{
			"source": "/recipes/service-worker.js",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-cache"
				}
			]
		},
		{
			"source": "/release.json",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "no-store"
				}
			]
		}
	],
	"functions": {
		"api/recipe-browse.mjs": {
			"includeFiles": "dist/recipes/{index.html,meals/index.html,smoothies/index.html}",
			"maxDuration": 10
		}
	}
}
